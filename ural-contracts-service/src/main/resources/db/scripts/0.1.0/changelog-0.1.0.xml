<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="create schema ural_contracts" author="kerzhakov">
        <sql>
            CREATE SCHEMA IF NOT EXISTS ural_contracts
        </sql>
    </changeSet>

    <changeSet id="create table contracts" author="kerzhakov">
        <createTable tableName="contracts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="car_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="cargo_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="DECIMAL"/>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz"/>
         </createTable>
    </changeSet>

</databaseChangeLog>